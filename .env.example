# Copy this file to .env and fill in only the providers you plan to use.
# Do NOT commit your real .env file.

# OpenAI - get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-me

# Anthropic - get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-replace-me

# Ollama runs locally and needs no key. Override the URL only if its not the default.
# When running the FastAPI app inside Docker and Ollama on the host, use:
#   http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# Default provider used by the API when the request doesn't specify one.
# One of: openai, anthropic, ollama
DEFAULT_LLM_PROVIDER=anthropic

# MongoDB connection (kept from the existing app)
MONGO_URL=mongodb://localhost:27017
